"VertexLitGeneric"
{
    "$basetexture" "models\furuki\binah_lor\BinahFace_rgb"
    "$bumpmap" "shared/normal"
	$selfillum 1
  	$selfillummask "models\furuki\binah_lor\faceem"
	$selfillumtint "[.80 .80 .80]"

 $lightwarptexture "shared/base"



    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[.01 0.1 0]"

    //rimlight doesn't properly show in hlmv, make sure you're changing these values in game
    "$rimlight" "1"
    "$rimlightexponent" "100"
    "$rimmask" "1"
    "$rimlightboost" "1"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////



}